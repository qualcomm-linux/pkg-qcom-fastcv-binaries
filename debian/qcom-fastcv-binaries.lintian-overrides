# usr/share/hexagon-dsp/ is a collection of prebuilt, proprietary
# binaries running on Hexagon DSPs (so a foreign architecture);
# these are not built using Debian tooling and are not currently
# trying to meet Debian expectations for host files
arch-independent-package-contains-binary-or-object [usr/share/hexagon-dsp/*/*/*/dsp/cdsp/*.so]
arch-dependent-file-in-usr-share [usr/share/hexagon-dsp/*/*/*/dsp/cdsp/*.so]
# DSP libs are excluded from dh_strip (host strip can't handle Hexagon ELF);
# some (e.g. Nord) are shipped unsigned by upstream
unstripped-binary-or-object [usr/share/hexagon-dsp/*/*/*/dsp/cdsp/*.so]
shared-library-lacks-stack-section [usr/share/hexagon-dsp/*/*/*/dsp/cdsp/lib*.so]
undeclared-elf-prerequisites (libc.so libdspCV_skel.so libfastcvadsp.so libgcc.so) [usr/share/hexagon-dsp/*/*/*/dsp/cdsp/libfastcvdsp_skel.so]
undeclared-elf-prerequisites (libc.so libdspCV_skel.so libgcc.so) [usr/share/hexagon-dsp/*/*/*/dsp/cdsp/libfastcvadsp.so]
undeclared-elf-prerequisites (libc.so libgcc.so) [usr/share/hexagon-dsp/*/*/*/dsp/cdsp/libdspCV_skel.so]
